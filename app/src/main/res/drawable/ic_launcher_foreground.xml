<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Speedometer Outer Ring Arc (Cyan to Pink Neon Gradient) -->
    <path
        android:pathData="M30,72 A32,32 0 1,1 78,72"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30"
                android:startY="72"
                android:endX="78"
                android:endY="30"
                android:type="linear">
                <item android:color="#00FFCC" android:offset="0.0" />
                <item android:color="#00FF66" android:offset="0.4" />
                <item android:color="#FFCC00" android:offset="0.7" />
                <item android:color="#FF0055" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Glow Track -->
    <path
        android:pathData="M34,70 A27,27 0 1,1 74,70"
        android:strokeWidth="1.5"
        android:strokeColor="#3300FFCC"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Speedometer Needle (Glowing Red/Pink Pointer pointing at speed) -->
    <path
        android:pathData="M54,54 L72,36"
        android:strokeWidth="3.5"
        android:strokeColor="#FF0055"
        android:strokeLineCap="round" />

    <!-- Center Needle Cap / Hub -->
    <path
        android:pathData="M54,54m-5,0a5,5 0 1,0 10,0a5,5 0 1,0 -10,0"
        android:fillColor="#00FFCC" />
    <path
        android:pathData="M54,54m-2.5,0a2.5,2.5 0 1,0 5,0a2.5,2.5 0 1,0 -5,0"
        android:fillColor="#FFFFFF" />

    <!-- Speedometer Tick Marks -->
    <path android:pathData="M27,54 L32,54" android:strokeWidth="2" android:strokeColor="#00FFCC" />
    <path android:pathData="M34,35 L38,38" android:strokeWidth="2" android:strokeColor="#00FF66" />
    <path android:pathData="M54,26 L54,31" android:strokeWidth="2" android:strokeColor="#FFCC00" />
    <path android:pathData="M74,35 L70,38" android:strokeWidth="2" android:strokeColor="#FF0055" />
    <path android:pathData="M81,54 L76,54" android:strokeWidth="2" android:strokeColor="#FF0055" />
</vector>
